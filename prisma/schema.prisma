generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  walletAddress String   @unique @map("wallet_address") @db.VarChar(42)
  createdAt     DateTime @default(now()) @map("created_at")
  agents        Agent[]

  @@map("users")
}

enum AgentStatus {
  draft
  deploying
  live
  failed
}

model Agent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  name        String      @db.VarChar(255)
  description String?     @db.Text
  canvasJson  Json        @map("canvas_json")
  metadataUri String?     @map("metadata_uri") @db.VarChar(512)
  status           AgentStatus @default(draft)
  workerUrl        String?     @map("worker_url") @db.VarChar(512)
  walletAddress    String?     @map("wallet_address") @db.VarChar(42)
  walletPrivateKey String?     @map("wallet_private_key") @db.Text
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@index([userId])
  @@map("agents")
}

enum DeploymentStatus {
  pending
  deploying
  deployed
  failed
}

model Deployment {
  id                 String           @id @default(uuid()) @db.Uuid
  agentId            String           @map("agent_id") @db.Uuid
  cloudflareWorkerId String?          @map("cloudflare_worker_id") @db.VarChar(255)
  deploymentStatus   DeploymentStatus @default(pending) @map("deployment_status")
  logs               Json?            @default("[]")
  workerUrl          String?          @map("worker_url") @db.VarChar(512)
  errorMessage       String?          @map("error_message") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("deployments")
}
