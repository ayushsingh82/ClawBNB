# ─── Database (Prisma) ───
# Run `npx prisma dev --detach` to start local Postgres, then copy the URL here
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."

# ─── Cloudflare Workers (Agent Deployment) ───
# Get these from https://dash.cloudflare.com → Workers & Pages → API Tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ─── x402 Payment ───
# Wallet address to receive deployment payments (Monad Testnet). Default in code: 0xB822B51A88E8a03fCe0220B15Cb2C662E42Adec1
PAY_TO_ADDRESS=0xB822B51A88E8a03fCe0220B15Cb2C662E42Adec1

# ─── WalletConnect ───
# Get a project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
