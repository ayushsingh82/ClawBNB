

# ─── Cloudflare Workers (Agent Deployment) ───
# Get these from https://dash.cloudflare.com → Workers & Pages → API Tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=9b67b1d22826d18b7d0415bfb50cf0fd

# ─── WalletConnect ───
# Get a project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Deploy Fee ───
# Wallet address that receives tBNB deploy fees (0.1 tBNB per skill)
NEXT_PUBLIC_DEPLOY_FEE_ADDRESS=0xYourWalletAddressHere
